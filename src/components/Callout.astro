---
// src/components/Callout.astro
// VERSÃO APERFEIÇOADA PARA DARK MODE (elonarte.com)

interface Props {
  type?: 'note' | 'warning' | 'danger' | 'success'; 
  title?: string;
}

const { type = 'note', title } = Astro.props;

// Os SVGs são ótimos porque podemos controlar a cor deles com CSS usando 'currentColor'.
const icons = {
  note: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line>
    </svg>
  `,
  warning: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line>
    </svg>
  `,
  danger: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
  `,
  success: `
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
  `,
};
---

<div class={`callout callout-${type}`}>
  {title && (
    <div class="callout-title">
      <span set:html={icons[type]} />
      <h4>{title}</h4>
    </div>
  )}
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    /* Cor de fundo sutilmente mais clara que o bg do site (#111827) para criar profundidade */
    background-color: #001234; /* Equivalente a slate-800 do Tailwind */
    /* Cor do texto padrão alinhada com o site */
    color: #fff2e8; /* Equivalente a gray-300 */
    border-left: 4px solid;
    border-radius: 8px;
    padding: 1rem 1.5rem;
    margin: 2rem 0;
  }

  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.75rem 0;
  }
  
  .callout-title h4 {
    margin: 0;
    line-height: 1.2;
  }

  /* O ícone herda a cor do texto do seu container (.callout-title) */
  .callout-title :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .callout-content {
    line-height: 1.65;
  }
  
  /* Cor do texto do conteúdo um pouco mais suave que o título */
  .callout-content > :global(p) {
    color: #9ca3af; /* Equivalente a gray-400 */
  }

  /* --- Estilos Específicos por Tipo --- */

  /* Estilo 'note', alinhado com o roxo/índigo de destaque do site */
  .callout-note {
    border-color: #818cf8; /* indigo-400 */
  }
  .callout-note .callout-title {
    color: #a5b4fc; /* indigo-300, um pouco mais claro para o título */
  }

  /* Estilo 'warning' */
  .callout-warning {
    border-color: #facc15; /* amber-400 */
  }
  .callout-warning .callout-title {
    color: #fde047; /* amber-300 */
  }

  /* Estilo 'danger' */
  .callout-danger {
    border-color: #f87171; /* red-400 */
  }
  .callout-danger .callout-title {
    color: #fca5a5; /* red-300 */
  }
  
  /* Estilo 'success' */
  .callout-success {
    border-color: #4ade80; /* green-400 */
  }
  .callout-success .callout-title {
    color: #86efac; /* green-300 */
  }
</style>