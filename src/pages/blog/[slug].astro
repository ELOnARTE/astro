---
// src/pages/blog/[slug].astro (Versão Final sem Tags)
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
    // 1. Buscamos e ordenamos todos os posts por data (do mais novo para o mais antigo)
    const posts = (await getCollection('blog')).sort(
        (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
    );

    return posts.map((post, index) => {
        // 2. A lógica para encontrar o post anterior e o próximo continua a mesma
        const prevPost = posts[index + 1] ?? null;
        const nextPost = posts[index - 1] ?? null;

        // --- LÓGICA DE POSTS RELACIONADOS ATUALIZADA ---
        // Em vez de usar tags, agora mostramos os 3 posts mais recentes,
        // garantindo que o post atual não seja incluído na lista.
        const relatedPosts = posts.filter(p => p.slug !== post.slug).slice(0, 3);

        return {
            params: { slug: post.slug },
            props: { 
                post,
                relatedPosts, // A prop continua existindo, mas com a nova lógica
                prevPost: prevPost ? { slug: prevPost.slug, title: prevPost.data.title } : null,
                nextPost: nextPost ? { slug: nextPost.slug, title: nextPost.data.title } : null,
            },
        };
    });
}

// A definição de Props continua a mesma, pois ainda passamos os 'relatedPosts'
type Props = {
    post: CollectionEntry<'blog'>;
    relatedPosts: CollectionEntry<'blog'>[];
    prevPost: { slug: string; title: string } | null;
    nextPost: { slug: string; title: string } | null;
};

const { post, relatedPosts, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
---
<Layout 
    title={post.data.title} 
    description={post.data.description} 
    image={post.data.heroImage?.src}
>
    <BlogPost 
        post={post}
        relatedPosts={relatedPosts}
        prevPost={prevPost}
        nextPost={nextPost}
    >
        <Content />
    </BlogPost>
</Layout>