---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
    const allPosts = await getCollection('blog');
    const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())].filter((tag): tag is string => typeof tag === 'string');

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) => (post.data.tags ?? []).includes(tag));
        return {
            params: { tag: tag.toLowerCase() },
            props: { posts: filteredPosts, tagName: tag },
        };
    });
}

const { posts, tagName } = Astro.props;
// MUDANÇA AQUI: Reutilizando a mesma lógica de cores
const tagColors = ['turquoise', 'purple', 'pink'];
---
<Layout title={`Posts com a tag: ${tagName}`} description={`Encontre todos os artigos sobre ${tagName} no blog da ELOnARTE.`}>
    <div class="container">
        <header class="blog-header">
            {/* MUDANÇA AQUI: Usando o nosso componente de tag no título para consistência */ }
            <h1>Tag: <span class:list={["tag", "tag-purple"]}>{tagName}</span></h1>
        </header>
        <main>
            <ul class="post-list">
                {posts.map((post: CollectionEntry<'blog'>) => (
                    <li>
                        {/* O link agora envolve apenas a imagem e o texto, as tags ficam fora */}
                        <a href={`/blog/${post.slug}/`} class="post-card">
                            <div class="image-container">
                                {post.data.heroImage && (
                                    <Image src={post.data.heroImage} alt={`Imagem de destaque para o post: ${post.data.title}`} width={800} height={450} quality={'high'} class="post-image" />
                                )}
                            </div>
                            <div class="post-text">
                                <h2 class="post-title">{post.data.title}</h2>
                                <p class="post-date">{new Date(post.data.pubDate).toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                <p class="post-description">{post.data.description}</p>
                                
                                <div class="card-tags">
                                    {post.data.tags?.map((tag, index) => {
                                        const colorClass = `tag-${tagColors[index % tagColors.length]}`;
                                        return (
                                            <a href={`/tags/${tag.toLowerCase()}`} class:list={["tag", colorClass]}>
                                                {tag}
                                            </a>
                                        )
                                    })}
                                </div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>
        </main>
    </div>
</Layout>

<style>
    /* Estilos gerais da página (maioria mantida) */
    .container { max-width: 900px; margin: auto; padding-bottom: 4rem; }
    .blog-header { text-align: center; margin: 4rem 0; }
    .blog-header h1 { font-size: 2.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex-wrap: wrap;}
    /* Removido '.blog-header span' pois agora o estilo vem da classe .tag */

    .post-list { list-style: none; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); }
    .post-card { display: flex; flex-direction: column; background-color: var(--color-bg-dark); border-radius: 12px; overflow: hidden; text-decoration: none; color: var(--text-body); transition: transform 0.3s ease; height: 100%; }
    .post-card:hover { transform: translateY(-5px); }
    .image-container { width: 100%; aspect-ratio: 16 / 9; background-color: var(--color-bg); }
    .post-image { width: 100%; height: 100%; object-fit: cover; }
    .post-text { padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; }
    .post-title { font-size: 1.25rem; margin-top: 0; margin-bottom: 0.5rem; color: var(--text-heading); }
    .post-date { font-size: 0.9rem; color: var(--color-text-primary); margin-bottom: 1rem; opacity: 0.7; }
    .post-description { font-size: 1rem; color: var(--color-text-primary); flex-grow: 1; }

    /* MUDANÇA AQUI: Estilo para o container das tags dentro do card */
    .card-tags {
        margin-top: 1.5rem; /* Espaçamento para separar do conteúdo */
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
</style>