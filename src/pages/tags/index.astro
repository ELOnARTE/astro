---
// src/pages/tags/index.astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const uniqueTags = [...new Set(posts.map((post) => post.data.tags).flat())].filter((tag) => typeof tag === 'string' && tag.length > 0);

// MUDANÇA AQUI: Array com as variações de cor que criamos no global.css
const tagColors = ['turquoise', 'purple', 'pink'];
---
<Layout title="Tags | ELOnARTE" description="Explore todos os tópicos e categorias do nosso blog.">
    <div class="tags-container">
        <h1>Todas as Tags</h1>
        <ul class="tag-list">
            {uniqueTags
                .map((tag, index) => {
                    // MUDANÇA AQUI: Lógica para alternar as cores
                    if (!tag) return null;
                    const colorClass = `tag-${tagColors[index % tagColors.length]}`;
                    return (
                        <li>
                            {/* MUDANÇA AQUI: Aplicando as classes globais */}
                            <a href={`/tags/${tag.toLowerCase()}`} class:list={["tag", colorClass]}>
                                {tag}
                            </a>
                        </li>
                    )
                })}
        </ul>
    </div>
</Layout>

<style>
    .tags-container {
        max-width: 70ch;
        margin: auto;
        padding: 4rem 1.5rem;
        text-align: center;
    }
    .tag-list {
        list-style: none;
        padding: 0;
        margin-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }
</style>